    {
      "id": "001",
      "name": "明《太祖实录》及历代明实录",
      "period": "明代（清入关前）",
      "category": "实录·编年体史书",
      "quantity": "明太祖至熹宗十三朝，共2923卷",
      "content": "明初建馆即将明代诸帝实录、宝训（圣训）存入；清顺治入主后沿用明制，但将明代实录移贮内阁书籍库，不再存放皇史宬。",
      "currentLocation": "清代已移贮内阁书库，不在皇史宬",
      "sourceTitle": "故宫·皇史宬明清皇家藏书楼",
      "sourceUrl": "https://www.dpm.org.cn/Uploads/File/2019/08/28/u5d66411c88089.pdf",
      "sourceRow": 3,
      "hall": "MainHall",
      "cabinetId": "N-W-05-05"
    },
